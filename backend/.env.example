# Server
PORT=3000
NODE_ENV=development

# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="your-private-key"
FIREBASE_CLIENT_EMAIL=your-client-email@project.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# JWT
JWT_SECRET=your-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Payment - Khalti
KHALTI_SECRET_KEY=your-khalti-secret-key
KHALTI_PUBLIC_KEY=your-khalti-public-key
KHALTI_API_URL=https://khalti.com/api/v2

# Payment - eSewa
ESEWA_MERCHANT_ID=your-esewa-merchant-id
ESEWA_SECRET_KEY=your-esewa-secret-key
ESEWA_API_URL=https://esewa.com.np/epay

# Payment - Stripe
STRIPE_SECRET_KEY=sk_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_your-stripe-publishable-key

# Redis
REDIS_URL=redis://localhost:6379

# App Config
FREE_AI_CALLS_PER_DAY=5
FREE_CV_DOWNLOADS_PER_MONTH=2
FREE_IMAGE_TO_PDF_PER_DAY=3
PREMIUM_MONTHLY_PRICE_NPR=299
PREMIUM_YEARLY_PRICE_NPR=2499
PREMIUM_MONTHLY_PRICE_USD=2.99
PREMIUM_YEARLY_PRICE_USD=24.99

# CORS
ALLOWED_ORIGINS=http://localhost:3000,https://aisathinepal.com
